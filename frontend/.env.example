# EmailJS credentials for the contact form.
# These were previously hardcoded in src/pages/Contact.jsx.
VITE_EMAILJS_SERVICE_ID=service_ypix5q7
VITE_EMAILJS_TEMPLATE_ID=template_5jfszow
