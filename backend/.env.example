NODE_ENV=development
PORT=4000

# Postgres connection string (Neon in production).
# Leave DATABASE_URL unset in development to fall back to a local SQLite file.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs admin session tokens. Use a long random string; changing it logs you out.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,https://dipeshmalla.vercel.app

# Optional. A classic token with no scopes is enough for public repositories;
# it only raises the GitHub API rate limit from 60 to 5000 requests an hour.
# GITHUB_TOKEN=

# Seeded on first `npm run db:seed`. Change the password immediately after.
ADMIN_EMAIL=dipeshmalla000@gmail.com
ADMIN_PASSWORD=change-me
